# Los paquetes del workspace se enlazan, no se copian
link-workspace-packages=true
# Evita fantasmas de dependencias: si no está en package.json, no se importa
strict-peer-dependencies=false
# Permite que los paquetes con binarios nativos ejecuten sus scripts de build
only-built-dependencies[]=@prisma/engines
only-built-dependencies[]=prisma
only-built-dependencies[]=esbuild
only-built-dependencies[]=sharp
only-built-dependencies[]=msgpackr-extract
only-built-dependencies[]=unrs-resolver
